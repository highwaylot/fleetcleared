{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then FC_LAUNCH=1 FC_HOLD_INDEX=1 python3 tools/build_site.py; else python3 tools/build_site.py; fi",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ],
  "crons": [
    { "path": "/api/cron_expire_holds", "schedule": "0 9 * * *" }
  ]
}
